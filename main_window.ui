   <string notr="true">QMainWindow {
    background-color: #0B1220;
    font-family: &quot;Segoe UI&quot;;
}

/* Labels */
QLabel {
    color: #7DD3FC;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    font-weight: bold;
}

/* Main Title */
QLabel#label_title {
    color: #4DA3FF;
    font-size: 24px;
    font-weight: bold;
}

/* Subtitle */
QLabel#label_subtitle {
    color: #94A3B8;
    font-size: 12px;
    font-weight: normal;
}

/* Line Edits */
QLineEdit {
    background-color: #162238;
    color: #FFFFFF;
    border: 2px solid #263B5A;
    border-radius: 10px;
    padding: 8px;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
}

QLineEdit:focus {
    border: 2px solid #4DA3FF;
}

/* Buttons */
QPushButton {
    color: #FFFFFF;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
    font-weight: bold;
    border: none;
    border-radius: 10px;
    padding: 9px 18px;
}

QPushButton#pushButton_add {
    background-color: #1976D2;
}

QPushButton#pushButton_add:hover {
    background-color: #2196F3;
}

QPushButton#pushButton_edit {
    background-color: #1565C0;
}

QPushButton#pushButton_edit:hover {
    background-color: #1E88E5;
}

QPushButton#pushButton_delete {
    background-color: #D84343;
}

QPushButton#pushButton_delete:hover {
    background-color: #EF5350;
}

QPushButton#pushButton_refresh {
    background-color: #0088CC;
}

QPushButton#pushButton_refresh:hover {
    background-color: #00A6F4;
}

/* Table */
QTableWidget {
    background-color: #111C2E;
    color: #EAF2FF;
    border: 2px solid #263B5A;
    border-radius: 10px;
    gridline-color: #263B5A;
    selection-background-color: #1976D2;
    selection-color: #FFFFFF;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
}

